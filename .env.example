# ---------------------------------------------------------------------------
# AI Platform — environment configuration
# Copy this file to `.env` and fill in what you have.
# VITE_* values are visible to the browser: put ONLY public identifiers here
# (Firebase web config is public by design and protected by Security Rules).
# Never put provider API keys, OAuth client secrets or admin credentials here.
# ---------------------------------------------------------------------------

# --- Gateway (server) --------------------------------------------------------
# The server gateway holds every provider API key, OAuth secret and search key.
# Leave empty for LOCAL MODE: provider keys are stored encrypted on the user's
# device only and the browser calls providers directly (no server needed).
VITE_GATEWAY_URL=

# --- Firebase Authentication + Firestore + Storage --------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Google sign-in (OAuth client id created in Firebase Console) -----------
VITE_FIREBASE_GOOGLE_CLIENT_ID=
