{
  "name": "ai-platform-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ai-platform-gateway",
      "database_id": "local"
    }
  ],
  "vars": {
    "ENV": "development"
  },
  "observability": {
    "enabled": true
  }
}
